# cp .env.example .env
# Read by the backend via pydantic-settings and by docker compose.

ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=teacher
POSTGRES_PASSWORD=teacher_dev_pw
POSTGRES_DB=teacher_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=dev-secret-change-me-in-production

# openai | anthropic | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Optional tier overrides. With LLM_PROVIDER=openai, empty values default to
# gpt-5.6-luna for fast routing/classification and gpt-5.6-terra for smart work.
# Other providers reuse LLM_MODEL unless these are set explicitly.
LLM_FAST_MODEL=
LLM_SMART_MODEL=
LLM_FAST_REASONING_EFFORT=none
LLM_SMART_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OLLAMA_BASE_URL=http://localhost:11434

# PDF -> Markdown. "text" needs no key but mangles mathematics; "mistral"
# ($2/1000 pages) and "gemini" (~$0.0006/page) return LaTeX.
# Pin the OCR model: "latest" moves and OCR 3 drops some formulas as images.
PDF_CONVERTER=text
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4
GEMINI_API_KEY=

# Per-turn cost accounting. These merge into the built-in table, so listing one
# model does not drop the rest. Tokens are always reported; an unpriced model
# shows its cost as unknown rather than a guess.
# MODEL_PRICES={"my-model": [input_usd_per_1M, output_usd_per_1M]}
# OpenAI examples (verified 2026-07): Luna [1,6], Terra [2.5,15],
# Sol [5,30], text-embedding-3-small [0.02,0].
# RERANK_PRICES={"my-reranker": usd_per_search}

# Figures from retrieved sections are sent to the model when it can see.
ANSWER_WITH_IMAGES=true
MAX_ANSWER_IMAGES=4

# Reranking. "llm" reuses the chat model and needs no extra account; "jina" is
# faster (~190ms) and sharper. cohere / voyage also supported.
RERANKER=llm
JINA_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=6

# Web search only ever runs on an explicit user action; off by default.
WEB_SEARCH_ENABLED=false
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_TOP_K=8
WEB_SEARCH_FETCH_PAGES=3
WEB_SEARCH_RATE_LIMIT_PER_HOUR=30

MAX_UPLOAD_SIZE_MB=100
MAX_REPO_SIZE_MB=200
MAX_REPO_FILES=2000
REPO_CLONE_TIMEOUT=120
MAX_CRAWL_PAGES=100
MAX_CRAWL_DEPTH=3
# Set false when a local proxy resolves every domain to fake-IP space.
CRAWL_BLOCK_PRIVATE_ADDRESSES=true

# Product-level AgentRun/Span persistence stays on even when external export is
# off. Set exporter=otlp after `make observability-up` to inspect traces in Jaeger.
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=teacher-agent-backend
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SAMPLE_RATIO=1.0
# Required for Replay. Turn off when prompts must not be retained in PostgreSQL.
OTEL_CAPTURE_CONTENT=true

# Typed Task DAG safety limits. Independent nodes in one topological layer run
# concurrently; a failed required dependency blocks downstream synthesis.
TASK_DAG_MAX_NODES=8
TASK_DAG_NODE_TIMEOUT_SECONDS=90
TASK_DAG_MAX_ATTEMPTS=2
TASK_DAG_LEASE_SECONDS=120

# Active workspace prompt override cache. API activation invalidates the local
# process immediately; other API/worker processes converge within this window.
PROMPT_CACHE_TTL_SECONDS=30

# Per-turn cost guard. Calls reserve the estimate before I/O, Smart requests
# downgrade to Fast near the soft limit, and the hard limit stops new calls.
RESOURCE_BUDGET_ENABLED=true
TURN_BUDGET_MAX_MODEL_CALLS=12
TURN_BUDGET_MAX_TOKENS=50000
TURN_BUDGET_MAX_COST_USD=1.0
TURN_BUDGET_SOFT_RATIO=0.8
TURN_BUDGET_ESTIMATED_INPUT_TOKENS=2000
TURN_BUDGET_ESTIMATED_OUTPUT_TOKENS=1000

# Workspace-isolated Redis cache for deterministic Router decisions and
# short-lived Web Search results. Set a TTL to 0 to bypass that cache.
RESOURCE_CACHE_ENABLED=true
ROUTER_CACHE_TTL_SECONDS=300
WEB_SEARCH_CACHE_TTL_SECONDS=300

# Redis-shared closed/open/half-open breakers for LLM, Web and reranker
# dependencies. Redis outages fall back to a process-local breaker.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=60
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_TIMEOUT_SECONDS=15
GOVERNANCE_REDIS_COOLDOWN_SECONDS=30

# User-owned long-term memory. Fast-tier extraction runs in ARQ after the Chat
# reply commits; semantic recall uses the configured pgvector embedding model.
MEMORY_ENABLED=true
MEMORY_RECALL_LIMIT=6
MEMORY_EXISTING_LIMIT=12
MEMORY_MAX_PER_USER=200
MEMORY_MIN_CONFIDENCE=0.65
MEMORY_RECALL_SCORE_THRESHOLD=0.42
MEMORY_CONFIDENCE_HALF_LIFE_DAYS=180
MEMORY_DEFAULT_TTL_DAYS=365
MEMORY_JOB_TIMEOUT_SECONDS=120

VITE_API_BASE_URL=http://localhost:8000/api/v1
